{
  "name": "imgpdf-toolbox",
  "version": "1.2.0",
  "description": "Suite ligera para manipular imágenes y PDFs con Ghostscript e ImageMagick",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": ["pdf", "image", "converter", "electron"],
  "author": "Juan Carlos De La Cruz Eligio | enfcarloseligio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.enfcarloseligio.imgpdf-toolbox",
    "productName": "ImgPDF Toolbox",
    "directories": { "output": "dist" },
    "win": {
      "target": "nsis",
      "icon": "renderer/assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": ["main.js", "preload.js", "renderer/**/*", "package.json"],
    "extraResources": [{ "from": "extraResources", "to": "bin" }]
  }
}
